# ==============================================================================
# EDUCATION ERP — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# DO NOT commit .env or .env.local to version control.
# ==============================================================================

# Application URL (used for redirects, email auth callbacks, canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain these values from your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
# Public Supabase URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anonymous Key (safe to expose to browser, subject to Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (CONFIDENTIAL - NEVER expose to browser or client code)
# Used only in secure server actions / background jobs requiring administrative bypass
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose

# ------------------------------------------------------------------------------
# Node Environment
# ------------------------------------------------------------------------------
NODE_ENV=development

